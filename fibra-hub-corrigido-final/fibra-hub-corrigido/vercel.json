{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/cadastro.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      },
      "dest": "/public/cadastro.html"
    },
    {
      "src": "/cliente.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      },
      "dest": "/public/cliente.html"
    },
    {
      "src": "/app.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      },
      "dest": "/public/app.js"
    },
    {
      "src": "/style.css",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      },
      "dest": "/public/style.css"
    },
    {
      "src": "/central/?",
      "dest": "/public/central/index.html"
    },
    {
      "src": "/central/(.*)",
      "dest": "/public/central/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/bloqueios",
      "schedule": "0 8 * * *"
    }
  ]
}
